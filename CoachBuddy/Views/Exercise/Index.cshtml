@using CoachBuddy.Application.Common
@model PaginatedResult<CoachBuddy.Application.Exercise.ExerciseDto>

@{
    ViewData["Title"] = "Exercises";
}

<h1>Exercises</h1>

<p>
    <a asp-action="Create" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-circle"></i> Add new exercise
    </a>
</p>

<form asp-action="Search" method="get" class="mb-4">
    <div class="input-group">
        <input type="text" name="searchTerm" placeholder="Search exercises..." class="form-control" />
        <button type="submit" class="btn btn-primary" id="searchButton">
            <i class="bi bi-search"></i> Search
        </button>
    </div>
</form>

@if (Model.Items.Any())
{
    <div class="row">
        @foreach (var exercise in Model.Items)
        {
            <div class="col-md-4 mb-4">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@exercise.Name</h5>
                        <p class="card-text text-muted">@exercise.Description</p>
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item"><strong>Description:</strong> @exercise.Description</li>
                            <li class="list-group-item"><strong>MuscleGroup:</strong> @exercise.MuscleGroup</li>
                        </ul>
                        <div class="mt-3">
                            <a class="btn btn-primary btn-sm" asp-controller="Exercise" asp-action="Details" asp-route-id="@exercise.Id">
                                <i class="bi bi-info-circle"></i> Details
                            </a>
                            @if (exercise.IsEditable)
                            {
                                <a class="btn btn-outline-secondary btn-sm" asp-controller="Exercise" asp-action="Edit" asp-route-id="@exercise.Id">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <a class="btn btn-outline-danger btn-sm" asp-controller="Exercise" asp-action="Delete" asp-route-id="@exercise.Id">
                                    <i class="bi bi-trash"></i> Delete
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <p>No exercises found.</p>
}

<nav aria-label="Page navigation">
    <ul class="pagination justify-content-center">
        @if (Model.HasPreviousPage)
        {
            <li class="page-item">
                <a class="btn btn-outline-secondary btn-sm" asp-action="Index" asp-route-pageNumber="@(Model.PageNumber - 1)" asp-route-pageSize="@Model.PageSize">Previous</a>
            </li>
        }

        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(Model.PageNumber == i ? "active" : "")">
                <a class="btn btn-outline-secondary btn-sm" asp-action="Index" asp-route-pageNumber="@i" asp-route-pageSize="@Model.PageSize">@i</a>
            </li>
        }

        @if (Model.HasNextPage)
        {
            <li class="page-item">
                <a class="btn btn-outline-secondary btn-sm" asp-action="Index" asp-route-pageNumber="@(Model.PageNumber + 1)" asp-route-pageSize="@Model.PageSize">Next</a>
            </li>
        }
    </ul>
</nav>
